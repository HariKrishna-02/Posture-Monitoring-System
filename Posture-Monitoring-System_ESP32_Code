#include <WiFi.h> 
#include <Wire.h> 
#include <Adafruit_MPU6050.h> 
#include <Adafruit_Sensor.h> 
  
const char* ssid = "YOUR_WIFI_SSID";                  
const char* password = "YOUR_WIFI_PASSWORD";          
  
#define FSR_BACK_PIN        34 
#define FSR_BELOW_LEFT_PIN  35 
#define FSR_BELOW_RIGHT_PIN 32 
#define MOTOR_PIN           25 
  
Adafruit_MPU6050 mpu; 
  
void setup() { 
  Serial.begin(115200); 
  delay(1000); 
  pinMode(MOTOR_PIN, OUTPUT); 
  digitalWrite(MOTOR_PIN, LOW); 
  
  WiFi.begin(ssid, password); 
  Serial.print("Connecting to WiFi"); 
  while (WiFi.status() != WL_CONNECTED) { 
    delay(500);  
    Serial.print("."); 
  } 
  Serial.println("\nWiFi connected!"); 
  Serial.print("IP Address: "); 
  Serial.println(WiFi.localIP()); 
  
  if (!mpu.begin()) { 
    Serial.println("MPU6050 initialization failed!"); 
    while (1); 
  } 
  mpu.setAccelerometerRange(MPU6050_RANGE_8_G); 
  mpu.setGyroRange(MPU6050_RANGE_500_DEG); 
  mpu.setFilterBandwidth(MPU6050_BAND_21_HZ); 
} 
  
void loop() { 
  int fsr_back = analogRead(FSR_BACK_PIN); 
  int fsr_left = analogRead(FSR_BELOW_LEFT_PIN); 
  int fsr_right = analogRead(FSR_BELOW_RIGHT_PIN); 
  
  sensors_event_t accel, gyro, temp; 
  mpu.getEvent(&accel, &gyro, &temp); 
  
  float ax = accel.acceleration.x; 
  float ay = accel.acceleration.y; 
  float az = accel.acceleration.z; 
  float gx = gyro.gyro.x; 
  float gy = gyro.gyro.y; 
  float gz = gyro.gyro.z; 
  
  float pitch = atan2(-ax, sqrt(ay*ay + az*az)) * 180 / PI; 
  float roll  = atan2(ay, az) * 180 / PI; 
  
  bool neck_slouch = (pitch < -20); 
  bool back_slouch = (roll < -25 || roll > 25); 
  
  String posture = "Good"; 
  if (neck_slouch && back_slouch) posture = "Neck & Back Slouch"; 
  else if (neck_slouch) posture = "Neck Slouch"; 
  else if (back_slouch) posture = "Back Slouch"; 
  
  digitalWrite(MOTOR_PIN, (neck_slouch || back_slouch) ? HIGH : LOW); 
  
  Serial.println(F("====== Posture Monitoring (Advanced) ======")); 
  Serial.printf("FSR Back:       %4d  |  FSR Below Left:  %4d  |  FSR Below 
Right:  %4d\n", fsr_back, fsr_left, fsr_right); 
  Serial.printf("Pitch: %6.1f°  |  Roll: %6.1f°\n", pitch, roll); 
  Serial.printf("Posture: %s  |  Motor: %s\n", posture.c_str(), 
(neck_slouch || back_slouch) ? "ON" : "OFF"); 
  Serial.printf("Accel (g): X=%.3f  Y=%.3f  Z=%.3f\n", ax, ay, az); 
  Serial.printf("Gyro (deg/s): X=%.3f  Y=%.3f  Z=%.3f\n", gx, gy, gz); 
  Serial.println(F("===========================================\n")); 
  
  delay(1000); 
} 
